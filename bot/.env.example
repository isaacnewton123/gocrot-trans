# Appwrite Cloud. Pakai endpoint region proyek, bukan https://cloud.appwrite.io/v1
APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=main
APPWRITE_BUCKET_ID=baileys-auth

# Gemini dicoba dulu, model demi model. Groq dipakai jika semua model Gemini gagal.
# GEMINI_MODELS / GROQ_MODELS opsional, dipisah koma, untuk mengganti daftar bawaan.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Halaman validasi publik. Kosongkan kalau domain Sites belum ada.
PUBLIC_VALIDATE_URL=https://NAMA-SITE.appwrite.network/validasi

# Diisi otomatis oleh Render. Untuk laptop, biarkan 3000.
PORT=3000
