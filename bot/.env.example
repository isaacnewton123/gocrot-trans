# MongoDB Atlas. Sama dengan MONGODB_URI di proyek Vercel. Jangan di-commit.
MONGODB_URI=

# Gemini dicoba dulu, model demi model. Groq dipakai jika semua model Gemini gagal.
# GEMINI_MODELS / GROQ_MODELS opsional, dipisah koma, untuk mengganti daftar bawaan.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Halaman validasi publik.
PUBLIC_VALIDATE_URL=https://gocrot-trans.vercel.app/validasi

# Diisi otomatis oleh Render. Untuk laptop, biarkan 3000.
PORT=3000
